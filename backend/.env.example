# Database (SQLite locally, PostgreSQL in production)
DATABASE_URL=sqlite:///./traffic_sense.db

# Authentication
JWT_SECRET=traffic_sense_jwt_secret_key_2026_super_secure
ADMIN_EMAIL=admin@trafficsense.gov
ADMIN_PASSWORD=Admin@123456

# CORS (Comma-separated for multiple origins, no trailing slashes)
FRONTEND_ORIGIN=https://traffic-sense-frontend.onrender.com,http://localhost:5173

# Storage (local | cloudinary | supabase)
STORAGE_BACKEND=local
# CLOUDINARY_URL=
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_BUCKET=evidence

# Environment & Architecture Mode
# Modes: "embedded" (runs AI worker in FastAPI lifespan thread - optimal for Render Free 512MB & local) or "hybrid" (external worker)
ENVIRONMENT=development
BACKEND_URL=http://localhost:8000
AI_WORKER_MODE=embedded
WORKER_SECRET_KEY=traffic_sense_worker_secret_2026

# AI Model Configuration
HELMET_MODEL_PATH=weights/helmet_yolov8.pt
PLATE_MODEL_PATH=weights/plate_yolov8.pt
FRAME_STRIDE=3
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=90
